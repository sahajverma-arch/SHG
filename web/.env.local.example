# Copy to .env.local and fill in.
# The app runs without these: the streak falls back to localStorage and
# Reading Aloud serves a built-in passage until Supabase is connected.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Points at the Python scoring service (see /scoring-service).
NEXT_PUBLIC_SCORING_SERVICE_URL=http://localhost:8000
