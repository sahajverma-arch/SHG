# ASR backend: "faster-whisper" (default, needs the conversion step in
# README.md) or "transformers" (slow on CPU, but no conversion needed).
ASR_BACKEND=faster-whisper
CT2_MODEL_PATH=models/whisper-hindi-small-ct2
CT2_COMPUTE_TYPE=int8
ASR_BEAM_SIZE=1

# Only used when ASR_BACKEND=transformers.
WHISPER_MODEL_ID=vasista22/whisper-hindi-small

# Recordings quieter than this are treated as silence and never sent to the
# model, which otherwise invents fluent speech out of nothing.
SILENCE_RMS_THRESHOLD=0.005

CORS_ORIGIN=http://localhost:3000
