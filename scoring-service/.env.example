# ASR backend: "faster-whisper" (default, needs the conversion step in
# README.md) or "transformers" (slow on CPU, but no conversion needed).
ASR_BACKEND=faster-whisper
CT2_MODEL_PATH=models/whisper-hindi-small-ct2
CT2_COMPUTE_TYPE=int8
ASR_BEAM_SIZE=1

# Only used when ASR_BACKEND=transformers.
WHISPER_MODEL_ID=vasista22/whisper-hindi-small

# Recordings quieter than this are treated as silence and never sent to the
# model, which otherwise invents fluent speech out of nothing.
SILENCE_RMS_THRESHOLD=0.005

# Voice for the "Hear it first" button (Microsoft Edge neural voice, via
# edge-tts).
#
#   hi-IN-SwaraNeural   female, the hi-IN voice
#   hi-IN-MadhurNeural  male, the hi-IN voice
#
# The newer "multilingual" voices are a later generation of model and sound
# markedly less synthetic. They are not labelled hi-IN, but they read
# Devanagari correctly -- each of these transcribes back through our own ASR
# at 20/20, same as the native Hindi voices:
#
#   en-US-EmmaMultilingualNeural       female
#   de-DE-SeraphinaMultilingualNeural  female
#   en-US-AndrewMultilingualNeural     male
#
# (en-US-AvaMultilingualNeural slurs some conjuncts -- it turned डूब into धूप.)
TTS_VOICE=hi-IN-SwaraNeural

# Playback rate for the model reading. Past about -10% the voice smears and
# starts to sound robotic.
TTS_RATE_SLOW=-10%
TTS_RATE_NORMAL=+0%

CORS_ORIGIN=http://localhost:3000
